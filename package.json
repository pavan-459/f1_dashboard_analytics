{
  "name": "f1-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && vitest run",
    "test:ci": "npm run test:unit:coverage && vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "record": "node scripts/record.js",
    "record:season": "node scripts/record-season.js",
    "test:watch": "vitest",
    "test:unit": "jasmine --config=spec/support/jasmine.json",
    "test:unit:coverage": "c8 --reporter=text-summary --reporter=text --include='src/transforms/**' --include='src/data/**' --check-coverage --lines 95 --functions 95 --branches 85 jasmine --config=spec/support/jasmine.json",
    "test:components": "vitest run",
    "test:smoke": "node scripts/smoke-app.js && node scripts/smoke-api.js",
    "test:smoke:app": "node scripts/smoke-app.js",
    "test:smoke:api": "node scripts/smoke-api.js",
    "test:load": "jasmine --config=spec/support/jasmine.load.json && node scripts/load.js"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-ease": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autocannon": "^7.15.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jasmine": "^5.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
